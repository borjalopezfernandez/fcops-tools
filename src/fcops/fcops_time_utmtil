def _init_eocfi(file_orbit: str, debug: bool = False):
    path_file_orbit     = importlib.resources.files(fcops) / 'data' / FLX_OSC
    path_sw_sdf         = importlib.resources.files(fcops) / 'data' / FLX_SDF
    path_zone_threshold = importlib.resources.files(fcops) / 'data' / FLX_ZONE_THRESHOLD
    path_zone_goal      = importlib.resources.files(fcops) / 'data' / FLX_ZONE_GOAL

    if file_orbit != None and file_orbit != '':
        if Path(file_orbit).is_file():
            path_file_orbit = file_orbit
        else:
            logger.error(f'cannot read {path_file_orbit}')
            exit(99)

    if debug == True:
        logger.info(f'xl_time_ref_init_file {os.path.basename(str(path_file_orbit))}')
   
    try:
        xl_time_ref_init_file(str(path_file_orbit), debug)
    except Exception as error:
        logger.error(f"Failed to init the time reference xl_time_ref_init_file with file {path_file_orbit}")
        logger.error(error)
        exit(99)

    if debug == True:
        logger.info(f'xo_verbose')
        xo_verbose(debug)

    if debug == True:
        logger.info(f'xo_orbit_init_file {path_file_orbit}')
    try:
        xo_orbit_init_file(str(path_file_orbit), debug)
    except Exception as error:
        logger.error(f"Failed to init the orbit reference xo_orbit_init_file with file {os.path.basename(str(path_file_orbit))}")
        logger.error(error)
        if debug == True:
            print(traceback.format_exc())
        exit(99)

    if debug == True:
        logger.info(f'xv_swath_id_init {os.path.basename(str(path_sw_sdf))}')
    swath_mode = XV_FILE_SDF
    xv_swath_id_init(swath_mode, str(path_sw_sdf), debug)
    return


def _eocfi_polygon(mjd2000_start: float, mjd2000_stop : float, datetime_start : datetime, datetime_stop : datetime, debug: bool = False):
    path_file_orbit         = importlib.resources.files(fcops) / 'data' / FLX_OSC
    path_sw_sdf             = importlib.resources.files(fcops) / 'data' / FLX_SDF
    path_zone_threshold     = importlib.resources.files(fcops) / 'data' / FLX_ZONE_THRESHOLD
    path_zone_goal          = importlib.resources.files(fcops) / 'data' / FLX_ZONE_GOAL

    if debug == True:
        logger.info(f'_eocfi_polygon {mjd2000_start} {mjd2000_stop} {datetime_start} {datetime_stop}')

    if debug == True:
        logger.info(f'xd_read_zone_id {os.path.basename(str(path_zone_threshold))}')
    list_zone_id        = xd_read_zone_id(str(path_zone_threshold), debug)

    list_zone_polygon   = []
    
    for zone_id in list_zone_id:    
        if debug == True:
            logger.info(f'xv_zonevistime_compute {zone_id}')
        
        list_xv_time_interval = xv_zonevistime_compute(str(path_zone_threshold), zone_id, mjd2000_start, mjd2000_stop, False)
        
        for xv_time_interval in list_xv_time_interval:
            time_start = float(xv_time_interval['xv_time_interval']['tstart']['utc_time'])
            time_end   = float(xv_time_interval['xv_time_interval']['tstop']['utc_time'])

            if debug == True:
                logger.info(f'xv_swathpos_compute {zone_id} {time_start} {time_end}')
  
            time_swath          = XV_Time()
            time_swath.type     = XV_UTC_TYPE
            time_swath.utc_time = time_start
            pos                 = xv_swathpos_compute(time_swath, False)
            # logger.debug(f"Computed position for {time_start}: {pos}")

            positions_west  = []
            positions_east  = []
            current_time    = datetime_start
            separation      = None
            while current_time <= datetime_stop:
                time_swath          = XV_Time()
                time_swath.type     = XV_UTC_TYPE
                time_swath.utc_time = eocfi.converters.datetime_utc_to_mjd2000(current_time)
                pos                 = xv_swathpos_compute(time_swath, False)
            
                # if debug == True:
                # logger.debug(f"Computed position for {current_time}: {pos}")
                
                # Avoid the swath middle point pos[1][1]
                positions_west.append(pos[1][0])
                positions_east.append(pos[1][2])
                current_time += timedelta(seconds = 10)
            
            coords = []
            '''
            if debug == True:
                logger.debug("")
                logger.debug(f"[{start_time} - {end_time} - {group_id}] Adding coordinates for position: {pos}")
            '''
                
            for pos in positions_east:
                coord = f"{pos['lon']},{pos['lat']}"
                '''
                if debug == True:
                    logger.info(f"Adding coordinate: {coord}")
                '''
                coords.append(coord)

            for pos in reversed(positions_west):
                coord = f"{pos['lon']},{pos['lat']}"
                '''
                if debug == True:
                    logger.info(f"Adding coordinate: {coord}")
                '''
                coords.append(coord)

            coord = f"{positions_east[0]['lon']},{positions_east[0]['lat']}"
            coords.append(coord)
            # logger.debug(f"Final coordinates for zone {zone_id}: {coords}")
            # zone_polygon = _eocfi_swathpos_to_polygon(zone_id, coords)
            zone_polygon = _eocfi_swathpos_to_polygon_proj(zone_id, coords, debug)
            # logger.debug(f"Polygon {zone_polygon}")
            list_zone_polygon.append(zone_polygon)
        
    return list_zone_polygon


def _parse_bbox(bbox_str):
    """Parse B_BOX string into list of (lat, lon) tuples."""
    values = list(map(float, bbox_str.strip().split()))
    # B_BOX format: lat1 lon1 lat2 lon2 lat3 lon3 lat4 lon4
    return [(values[i], values[i+1]) for i in range(0, len(values), 2)]


def _get_bboxes_by_tile_id(filepath):
    """Return dict of {TILE_IDENTIFIER: [(lat, lon), ...]} from the .dbl XML file."""
    tree = ET.parse(filepath)
    root = tree.getroot()

    result = {}
    for tile in root.iter("TILE"):
        tile_id = tile.findtext("TILE_IDENTIFIER")
        bbox_str = tile.findtext("B_BOX")
        if tile_id and bbox_str:
            result[tile_id] = _parse_bbox(bbox_str)

    return result


def _utm_bbox_to_polygon(tile, utm_bbox):
    """ Convert UTM bounding box to a Shapely Polygon and return a dict {tile: polygon} """
    # print(f"{tile} {utm_bbox}")
    lon_lat_coords  = [(utm_bbox[0][1], utm_bbox[0][0]), (utm_bbox[1][1], utm_bbox[1][0]), (utm_bbox[2][1], utm_bbox[2][0]), (utm_bbox[3][1], utm_bbox[3][0])]
    geo_polygon     = Polygon(lon_lat_coords)
    dict_utm_tile   = {tile: geo_polygon}
    return dict_utm_tile


def _utm_bbox_to_polygon_proj(tile, utm_bbox, debug: bool = False):
    """ Convert UTM bounding box to a pyproj Polygon and return a dict {tile: polygon} """
    # Initialise the pyproj
    transformer         = Transformer.from_crs("EPSG:4326", "EPSG:6933", always_xy = True)
    lon_lat_coords      = [(utm_bbox[0][1], utm_bbox[0][0]), (utm_bbox[1][1], utm_bbox[1][0]), (utm_bbox[2][1], utm_bbox[2][0]), (utm_bbox[3][1], utm_bbox[3][0])]
    polygon             = Polygon(lon_lat_coords)
    '''
    if debug == True:
        logger.debug(f"Polygon UTM before projection: {polygon}")
    '''
    polygon_proj        = transform(transformer.transform, polygon)
    dict_utm_tile       = {tile: polygon_proj}
    return dict_utm_tile


def _eocfi_swathpos_to_polygon(zone, coordinates):
    """ Convert zonevistime by eocfi to a Shapely Polygon and return a dict {zone: polygon} """
    lon_lat_coords      = [tuple(float(x) for x in s.split(',')) for s in coordinates]
    geo_polygon         = Polygon(lon_lat_coords)
    dict_zone_tile      = {zone: geo_polygon}
    return dict_zone_tile


def _eocfi_swathpos_to_polygon_proj(zone, coordinates, debug: bool = False):
    """ Convert zonevistime by eocfi to a pyproj Polygon and return a dict {zone: polygon} """
    # Initialise the pyproj
    transformer         = Transformer.from_crs("EPSG:4326", "EPSG:6933", always_xy = True)
    lon_lat_coords      = [tuple(float(x) for x in s.split(',')) for s in coordinates]
    polygon             = Polygon(lon_lat_coords)
    if debug == True:
        logger.debug(f"Polygon before projection: {polygon}")
    polygon_proj        = transform(transformer.transform, polygon)
    dict_zone_tile      = {zone: polygon_proj}
    return dict_zone_tile

import click
CONTEXT_SETTINGS = {"help_option_names": ['-h', '--help'], "max_content_width" : 220}

@click.command(context_settings=CONTEXT_SETTINGS, no_args_is_help = True)
@click.option('--time-start',   '-s',       help = 'input time start UTC=20230724T120000 | (MJD2000) 8605.5')
@click.option('--time-end',     '-e',       help = 'input time end   UTC=20230725T000000 | (MJD2000) 8606.0')
@click.option('--file-orbit',   '-o',       help = 'orbit ephemeris file')
@click.option('--version', '-v',        is_flag = True, default = False,    help = 'It shows the version')
@click.option('--Silent', '-S',         is_flag = True, default = False,    help = 'Avoid logging messages')
@click.option('--Debug', '-D',          is_flag = True, default = False,    help = 'Debug flag for verbose messages')


def get_polygons(time_start: str, time_end: str, file_orbit: str, version: bool, silent: bool, debug: bool):

    """
    \b
    Get the UTM tile identifier and its bounding box coordinates.
    \b

    """    

    if version == True:
        print(f"{os.path.basename(__file__)} - {package_version('fcops')}")
        print(f'eocfi - {eocfi_version()}')
        xo_check_library_version()
        exit(0)

    if time_start is None or time_end is None:
        logger.error('Both --time-start and --time-end options are required.')
        exit(99)

    # initialise EOCFI
    _init_eocfi(file_orbit, debug)

    if '=' in time_start:
        match time_start.split('=')[0]:
        
            case 'MJD2000':
                # ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
                ascii_id_out        = XL_ASCII_CCSDSA_MICROSEC
                time_ref_in         = XL_TIME_UTC
                proc_id_in          = XL_PROC
                time_ref_out        = XL_TIME_UTC
                processing_in       = float( time_start.split('=')[1] )
                ascii_time          = xl_time_processing_to_ascii(proc_id_in,
                                                time_ref_in,
                                                processing_in,
                                                ascii_id_out,
                                                time_ref_out,
                                                debug)
                
            case 'UTC':
                ascii_id_in         = XL_ASCII_CCSDSA_COMPACT
                time_ref_in         = XL_TIME_UTC
                ascii_in            = time_start.split('=')[1]
                proc_id_out         = XL_PROC
                time_ref_out        = XL_TIME_UTC
                mjd2000             = xl_time_ascii_to_processing(
                                                ascii_id_in,
                                                time_ref_in,
                                                ascii_in,
                                                proc_id_out,
                                                time_ref_out,
                                                debug)
                time_start = mjd2000
            case _:
                logger.error(f'Time unit not supported or recognised for time_start: {time_start.split("=")[0]}')
                if debug == True:
                    raise Exception(f'Time unit not supported or recognised for time_start')
                exit(99)
    else:
        time_start  = float(time_start)
    

    if '=' in time_end:
        match time_end.split('=')[0]:
        
            case 'MJD2000':
                # ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
                ascii_id_out        = XL_ASCII_CCSDSA_MICROSEC
                time_ref_in         = XL_TIME_UTC
                proc_id_in          = XL_PROC
                time_ref_out        = XL_TIME_UTC
                processing_in       = float( time_end.split('=')[1] )
                ascii_time          = xl_time_processing_to_ascii(proc_id_in,
                                                time_ref_in,
                                                processing_in,
                                                ascii_id_out,
                                                time_ref_out,
                                                debug)
                
            case 'UTC':
                ascii_id_in         = XL_ASCII_CCSDSA_COMPACT
                time_ref_in         = XL_TIME_UTC
                ascii_in            = time_end.split('=')[1]
                proc_id_out         = XL_PROC
                time_ref_out        = XL_TIME_UTC
                mjd2000             = xl_time_ascii_to_processing(
                                                ascii_id_in,
                                                time_ref_in,
                                                ascii_in,
                                                proc_id_out,
                                                time_ref_out,
                                                debug)
                time_end = mjd2000
            case _:
                logger.error(f'Time unit not supported or recognised for time_end: {time_end.split("=")[0]}')
                if debug == True:
                    raise Exception(f'Time unit not supported or recognised for time_end')
                exit(99)
    else:
        time_end = float(time_end)

    # Variables for time conversion
    ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
    time_ref_in         = XL_TIME_UTC
    proc_id_in          = XL_PROC
    time_ref_out        = XL_TIME_UTC  

    ascii_time_validity_start = xl_time_processing_to_ascii(proc_id_in,
                                              time_ref_in,
                                              time_start,
                                              ascii_id_out,
                                              time_ref_out,
                                              debug)

    ascii_time_validity_end   = xl_time_processing_to_ascii(proc_id_in,
                                              time_ref_in,
                                              time_end,
                                              ascii_id_out,
                                              time_ref_out,
                                              debug)

    datetime_validity_start = datetime.strptime(ascii_time_validity_start, '%Y%m%dT%H%M%S').replace(tzinfo=timezone.utc)
    datetime_validity_end   = datetime.strptime(ascii_time_validity_end, '%Y%m%dT%H%M%S').replace(tzinfo=timezone.utc)
    list_zone_polygons      = _eocfi_polygon(time_start, time_end, datetime_validity_start, datetime_validity_end, debug)
    
    path_aux_utmtil         = importlib.resources.files(fcops) / 'data' / FLX_AUX_UTMTIL
    utm_bboxes              = _get_bboxes_by_tile_id(path_aux_utmtil)
    
    list_utm_polygons       = []
    list_utm_polygons_proj  = []
    for tile_id, corners in utm_bboxes.items():
        # polygon_utm = _utm_bbox_to_polygon(tile_id, corners)
        polygon_utm = _utm_bbox_to_polygon_proj(tile_id, corners, debug)
        # logger.debug(f"Polygon: {polygon_utm}")
        list_utm_polygons.append(polygon_utm)

    for zone_polygon in list_zone_polygons:
        # logger.info(f"{zone_polygon}")
        zone_id = next(iter(zone_polygon))
        # logger.info(f"Zone {zone_id} polygon: {zone_polygon[zone_id]}")
        
        for utm_polygon in list_utm_polygons:
            utm_tile_id  = next(iter(utm_polygon))
            # logger.info(f"UTM tile {utm_tile_id} polygon: {utm_polygon[utm_tile_id]}")
            intersection = zone_polygon[zone_id].intersection(utm_polygon[utm_tile_id])
            if not intersection.is_empty:
                logger.info(f'{zone_id} - {utm_tile_id}')
            #else:
            #    logger.info('niente')

 


    return list_zone_polygons, list_utm_polygons

