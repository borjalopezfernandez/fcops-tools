@click.command(context_settings=CONTEXT_SETTINGS, no_args_is_help = False)
@click.option('--time-start',  '-s',    help = 'input time start UTC=20230724T120000 | (MJD2000) 8605.5')
@click.option('--time-end',  '-e',      help = 'input time end   UTC=20230725T000000 | (MJD2000) 8606.0')
