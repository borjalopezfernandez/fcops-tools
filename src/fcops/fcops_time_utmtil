@click.option('--Silent', '-S',      is_flag = True, default = False,    help = 'Avoid logging messages')
@click.option('--Debug', '-D',       is_flag = True, default = False,    help = 'Debug flag for verbose messages')


def get_utmtil(time_start: str, time_end: str, version: bool, silent: bool, debug: bool):

    """
    \b
    Get the UTM tile identifier and its bounding box coordinates.
    \b

    """    

    if version == True:
        print(f"{os.path.basename(__file__)} - {package_version('fcops')}")
        print(f'eocfi - {eocfi_version()}')
        xo_check_library_version()
        exit(0)

    # initialise EOCFI
    _init_eocfi(debug)

    if '=' in time_start:
        match time_start.split('=')[0]:
        
            case 'MJD2000':
                # ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
                ascii_id_out        = XL_ASCII_CCSDSA_MICROSEC
                time_ref_in         = XL_TIME_UTC
                proc_id_in          = XL_PROC
                time_ref_out        = XL_TIME_UTC
                processing_in       = float( time_start.split('=')[1] )
                ascii_time          = xl_time_processing_to_ascii(proc_id_in,
                                                time_ref_in,
                                                processing_in,
                                                ascii_id_out,
                                                time_ref_out,
                                                debug)
                
            case 'UTC':
                ascii_id_in         = XL_ASCII_CCSDSA_COMPACT
                time_ref_in         = XL_TIME_UTC
                ascii_in            = time_start.split('=')[1]
                proc_id_out         = XL_PROC
                time_ref_out        = XL_TIME_UTC
                mjd2000             = xl_time_ascii_to_processing(
                                                ascii_id_in,
                                                time_ref_in,
                                                ascii_in,
                                                proc_id_out,
                                                time_ref_out,
                                                debug)
                time_start = mjd2000
            case _:
                logger.error(f'Time unit not supported or recognised for time_start: {time_start.split("=")[0]}')
                if debug == True:
                    raise Exception(f'Time unit not supported or recognised for time_start')
                exit(99)
    else:
        time_start  = float(time_start)
    

    if '=' in time_end:
        match time_end.split('=')[0]:
        
            case 'MJD2000':
                # ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
                ascii_id_out        = XL_ASCII_CCSDSA_MICROSEC
                time_ref_in         = XL_TIME_UTC
                proc_id_in          = XL_PROC
                time_ref_out        = XL_TIME_UTC
                processing_in       = float( time_end.split('=')[1] )
                ascii_time          = xl_time_processing_to_ascii(proc_id_in,
                                                time_ref_in,
                                                processing_in,
                                                ascii_id_out,
                                                time_ref_out,
                                                debug)
                
            case 'UTC':
                ascii_id_in         = XL_ASCII_CCSDSA_COMPACT
                time_ref_in         = XL_TIME_UTC
                ascii_in            = time_end.split('=')[1]
                proc_id_out         = XL_PROC
                time_ref_out        = XL_TIME_UTC
                mjd2000             = xl_time_ascii_to_processing(
                                                ascii_id_in,
                                                time_ref_in,
                                                ascii_in,
                                                proc_id_out,
                                                time_ref_out,
                                                debug)
                time_end = mjd2000
            case _:
                logger.error(f'Time unit not supported or recognised for time_end: {time_end.split("=")[0]}')
                if debug == True:
                    raise Exception(f'Time unit not supported or recognised for time_end')
                exit(99)
    else:
        time_end = float(time_end)

    # Variables for time conversion
    ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
    time_ref_in         = XL_TIME_UTC
    proc_id_in          = XL_PROC
    time_ref_out        = XL_TIME_UTC  

    ascii_time_validity_start = xl_time_processing_to_ascii(proc_id_in,
                                              time_ref_in,
                                              time_start,
                                              ascii_id_out,
                                              time_ref_out,
                                              debug)

    ascii_time_validity_end   = xl_time_processing_to_ascii(proc_id_in,
                                              time_ref_in,
                                              time_end,
                                              ascii_id_out,
                                              time_ref_out,
                                              debug)

    datetime_validity_start = datetime.strptime(ascii_time_validity_start, '%Y%m%dT%H%M%S')
    datetime_validity_end   = datetime.strptime(ascii_time_validity_end, '%Y%m%dT%H%M%S')

    logger.info(time_start)
    logger.info(time_end)
    logger.info(datetime_validity_start)
    logger.info(datetime_validity_end)

    _eocfi_zonevistime(time_start, time_end, datetime_validity_start, datetime_validity_end, debug)
    exit(0)


