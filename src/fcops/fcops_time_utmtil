def _parse_bbox(bbox_str):
    """Parse B_BOX string into list of (lat, lon) tuples."""
    values = list(map(float, bbox_str.strip().split()))
    # B_BOX format: lat1 lon1 lat2 lon2 lat3 lon3 lat4 lon4
    return [(values[i], values[i+1]) for i in range(0, len(values), 2)]

def _get_bboxes_by_tile_id(filepath):
    """Return dict of {TILE_IDENTIFIER: [(lat, lon), ...]} from the .dbl XML file."""
    tree = ET.parse(filepath)
    root = tree.getroot()

    result = {}
    for tile in root.iter("TILE"):
        tile_id = tile.findtext("TILE_IDENTIFIER")
        bbox_str = tile.findtext("B_BOX")
        if tile_id and bbox_str:
            result[tile_id] = _parse_bbox(bbox_str)

    return result



import click
