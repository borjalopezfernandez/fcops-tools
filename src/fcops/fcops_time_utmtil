        print(f"{os.path.basename(__file__)} - {package_version('fcops')}")
        print(f'eocfi - {eocfi_version()}')
        xo_check_library_version()
        exit(0)

    _init_eocfi(debug)

    exit(0)



    if '=' in time_start:
        match time_start.split('=')[0]:
        
            case 'MJD2000':
                # ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
                ascii_id_out        = XL_ASCII_CCSDSA_MICROSEC
                time_ref_in         = XL_TIME_UTC
                proc_id_in          = XL_PROC
                time_ref_out        = XL_TIME_UTC
                processing_in       = float( time_start.split('=')[1] )
                ascii_time          = xl_time_processing_to_ascii(proc_id_in,
                                                time_ref_in,
                                                processing_in,
                                                ascii_id_out,
                                                time_ref_out,
                                                debug)
                
            case 'UTC':
                ascii_id_in         = XL_ASCII_CCSDSA_COMPACT
                time_ref_in         = XL_TIME_UTC
                ascii_in            = time_start.split('=')[1]
                proc_id_out         = XL_PROC
                time_ref_out        = XL_TIME_UTC
                mjd2000             = xl_time_ascii_to_processing(
                                                ascii_id_in,
                                                time_ref_in,
                                                ascii_in,
                                                proc_id_out,
                                                time_ref_out,
                                                debug)
                time_start = mjd2000
            case _:
                logger.error(f'Time unit not supported or recognised for time_start: {time_start.split("=")[0]}')
                if debug == True:
                    raise Exception(f'Time unit not supported or recognised for time_start')
                exit(99)
    else:
        time_start  = float(time_start)
    

    if '=' in time_end:
        match time_end.split('=')[0]:
        
            case 'MJD2000':
                # ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
                ascii_id_out        = XL_ASCII_CCSDSA_MICROSEC
                time_ref_in         = XL_TIME_UTC
                proc_id_in          = XL_PROC
                time_ref_out        = XL_TIME_UTC
                processing_in       = float( time_end.split('=')[1] )
                ascii_time          = xl_time_processing_to_ascii(proc_id_in,
                                                time_ref_in,
                                                processing_in,
                                                ascii_id_out,
                                                time_ref_out,
                                                debug)
                
            case 'UTC':
                ascii_id_in         = XL_ASCII_CCSDSA_COMPACT
                time_ref_in         = XL_TIME_UTC
                ascii_in            = time_end.split('=')[1]
                proc_id_out         = XL_PROC
                time_ref_out        = XL_TIME_UTC
                mjd2000             = xl_time_ascii_to_processing(
                                                ascii_id_in,
                                                time_ref_in,
                                                ascii_in,
                                                proc_id_out,
                                                time_ref_out,
                                                debug)
                time_end = mjd2000
            case _:
                logger.error(f'Time unit not supported or recognised for time_end: {time_end.split("=")[0]}')
                if debug == True:
                    raise Exception(f'Time unit not supported or recognised for time_end')
                exit(99)
    else:
        time_end = float(time_end)

    # Variables for time conversion
    ascii_id_out        = XL_ASCII_CCSDSA_COMPACT
    time_ref_in         = XL_TIME_UTC
    proc_id_in          = XL_PROC
    time_ref_out        = XL_TIME_UTC  

    ascii_time_validity_start = xl_time_processing_to_ascii(proc_id_in,
                                              time_ref_in,
                                              time_start,
                                              ascii_id_out,
                                              time_ref_out,
                                              debug)

    ascii_time_validity_end   = xl_time_processing_to_ascii(proc_id_in,
                                              time_ref_in,
                                              time_end,
                                              ascii_id_out,
                                              time_ref_out,
                                              debug)

    datetime_validity_start = datetime.datetime.strptime(ascii_time_validity_start, '%Y%m%dT%H%M%S')
    datetime_validity_end   = datetime.datetime.strptime(ascii_time_validity_end, '%Y%m%dT%H%M%S')



    str_datetime_start  = start
    str_datetime_end    = end
    date_format         = '%Y-%m-%dT%H:%M:%S'

    datetime_start      = None
    datetime_end        = None
    
    try:
        datetime_start      = datetime.strptime(str_datetime_start, date_format)
        datetime_end        = datetime.strptime(str_datetime_end, date_format)
    except Exception as e:
        print(f'Error parsing input datetimes: {e}')
        exit(1)

    if datetime_start >= datetime_end:
        print('Error: start datetime must be before end datetime')
        exit(1)

