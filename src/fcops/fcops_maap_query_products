#!/usr/bin/env python

from pystac_client import Client
from datetime import datetime, timezone
import pytz
import csv as csv_file

from loguru import logger
logger = logger.patch(lambda record: record.update(name=record["file"].name))

import click
CONTEXT_SETTINGS = {"help_option_names": ['-h', '--help'], "max_content_width" : 220}

@click.command(context_settings=CONTEXT_SETTINGS, no_args_is_help = True)
@click.option('--start', '-s',                                           help = 'start datetime in format YYYY-MM-DDThh:mm:ssZ / 2025-10-22T00:00:00Z')
@click.option('--end', '-e',                                             help = 'end datetime in format YYYY-MM-DDThh:mm:ssZ / 2025-10-23T00:00:00Z')
@click.option('--type', '-t',                                            help = 'API productType filter RAW_XS_HR1 | RAW_XS_HR2 | RAW_XS_LR_', default = 'RAW_XS_HR1')
@click.option('--baseline', '-b',                                        help = 'API product version attribute matching the baseline (e.g. 02)')
@click.option('--CSV', '-C',         is_flag = True, default = False,    help = 'Output results to CSV file')
@click.option('--version', '-v',     is_flag = True, default = False,    help = 'It shows the version')
@click.option('--Silent', '-S',      is_flag = True, default = False,    help = 'Avoid logging messages')
@click.option('--Debug', '-D',       is_flag = True, default = False,    help = 'Debug flag for verbose messages')

def query_datatakes(start: str, end: str, type: str, baseline: str, csv: bool, version: bool, silent: bool, debug: bool):

    """
    \b
    Query MAAP catalogue for FLEX products data-take information within some time interval and product type within the following collections:
    > FLEXRAWProductsInternal:
    - RAW_XS_HR1
    - RAW_XS_HR2
    - RAW_XS_LR_
    - RAW_XS_OBC
    \b

    \b
    > FLEXL0AncProductsInternal:
    - L0__SAT_TM
    - L0__PDHUTM
    - L0__ICUDTM
    - L0__NAVATT
    \b

    \b
    > FLEXL0NotNomProductsInternal:
    - L0__TST_H1
    - L0__TST_H2
    - L0__TST_LR
    \b


    
    \b
    CSV file naming convention is:
        fcops_maap_query_datatake_<product_type>_<start_datetime>_<end_datetime>_C<current_datetime>.csv

    CSV file format is:
        datatake_id, product_type, product_id, sensing_start, sensing_end

    Auxiliary products are datatake-less and no grouping is performed.
    \b

    """

    URL_LANDING_PAGE =  'https://catalog.maap.eo.esa.int/catalogue/'
    api = Client.open(URL_LANDING_PAGE) 

    str_datetime_start  = start
    str_datetime_end    = end
    date_format         = '%Y-%m-%dT%H:%M:%SZ'

    datetime_start     = None
    datetime_end       = None
        
    try:
        datetime_start      = datetime.strptime(str_datetime_start, date_format).replace(tzinfo=timezone.utc)
        datetime_end        = datetime.strptime(str_datetime_end, date_format).replace(tzinfo=timezone.utc)
    except Exception as e:
        print(f'Error parsing input datetimes: {e}')
        exit(1)   

    flex_collections     = None

    if type in ['RAW_XS_HR1', 'RAW_XS_HR2', 'RAW_XS_LR_', 'RAW_XS_OBC']:
        flex_collections = ['FLEXRAWProductsInternal']

    if type in ['L0__SAT_TM', 'L0__PDHUTM', 'L0__ICUDTM', 'L0__NAVATT']:
        flex_collections = ['FLEXL0AncProductsInternal']

    if type in ['L0__TST_H1', 'L0__TST_H2', 'L0__TST_LR']:
        flex_collections = ['FLEXL0NotNomProductsInternal']

    if flex_collections is None:
        logger.error(f"Error: product type {type} is not supported")
        exit(1)
    
    datetime_now        = datetime.now(pytz.utc)
    
    if baseline == None:
        filename            = f'fcops_maap_query_datatake_{type}_{datetime_start.strftime("%Y%m%dT%H%M%S")}_{datetime_end.strftime("%Y%m%dT%H%M%S")}_C{datetime_now.strftime("%Y%m%dT%H%M%S")}.csv'
    else:
        filename            = f'fcops_maap_query_datatake_{type}_B{baseline}_{datetime_start.strftime("%Y%m%dT%H%M%S")}_{datetime_end.strftime("%Y%m%dT%H%M%S")}_C{datetime_now.strftime("%Y%m%dT%H%M%S")}.csv'

    api = None
    try:
        api  = Client.open(URL_LANDING_PAGE)
    except Exception as e:
        logger.error(f"Error when connecting to {URL_LANDING_PAGE}")
        logger.error(f"{e}")
        exit(1)
    
    if debug == True:
        if baseline == None:
            logger.debug(f'{str_datetime_start} to {str_datetime_end} => querying {type} all baseline products in collections {flex_collections}')
        else:
            logger.debug(f'{str_datetime_start} to {str_datetime_end} => querying {type} products in collections {flex_collections} with baseline {baseline}')


    if baseline is not None:
        if debug == True:
            logger.debug(f"api.search GET limit = 500 ; collection = {flex_collections} ; filter = productType='{type}' and version='{baseline}' ; datetime = [{datetime_start}, {datetime_end}]")
        results = api.search(
            method      = 'GET',
            limit       = 500,
            collections = flex_collections,
            filter      = f"productType='{type}' and version='{baseline}'",
            datetime    = [datetime_start, datetime_end]
        )
    else:
        if debug == True:
            logger.debug(f"api.search GET limit = 500 ; collection = {flex_collections} ; filter = productType='{type}' ; datetime = [{datetime_start}, {datetime_end}]")
        results = api.search(
            method      =   'GET',
            limit       =   500,
            collections =   flex_collections,
            filter      =   f"(productType='{type}')",
            datetime    =   [f'{datetime_start.strftime("%Y-%m-%dT%H:%M:%SZ")}', f'{datetime_end.strftime("%Y-%m-%dT%H:%M:%SZ")}']
        )

    num_matched = results.matched()

    if not silent:
        print(f"{num_matched} items found")

    if debug == True:
        logger.debug(f"{num_matched} items found")

    records=[]

    counter_items = 0

    try:
        for i, it in enumerate(results.items(), 1):
            counter_items = i
            if not silent:
                print(f"\r{i}", end=' ', flush = True)
            d = it.to_dict()

            flat = {
                'product_id'        : d.get("id"),
                'platform'          : d['properties'].get('platform'),
                'start_datetime'    : d['properties'].get('start_datetime'),
                'end_datetime'      : d['properties'].get('end_datetime'),
                'product_type'      : d['properties'].get('product:type'),
                'global_coverage'   : d['properties'].get('eofeos:global_coverage_id'),
                'major_cycle'       : d['properties'].get('eofeos:major_cycle_id'),
                'phase'             : d['properties'].get('eofeos:mission_phase'),
                'drift_flag'        : d['properties'].get('eofeos:orbit_drift_flag'),
                'repeat_cycle'      : d['properties'].get('eofeos:repeat_cycle_id'),
                'datatake_id'       : d['properties'].get('eopf:datatake_id'),
            }
            records.append(flat)
    except Exception as e:
        logger.error(f"Error querying maap at item retrieval {counter_items}/{num_matched}")
        logger.error(e)
        exit(99)

    list_sorted         = sorted(records, key=lambda x: x['product_id'])

    file_handler        = open(filename, mode = 'w', newline = '')  
    csv_writer          = csv_file.writer(file_handler, delimiter = ',')
    header              = ['datatake_id', 'product_type', 'product_id', 'sensing_start', 'sensing_end']
    csv_writer.writerow(header)

    prev_datatake = None
    if not silent:
        print()

    for i, item in enumerate(list_sorted, 1):
        row = [
                item['datatake_id'],
                item['product_type'],
                item['product_id'],
                item['start_datetime'],
                item['end_datetime']
            ]

        if debug == True:
            print(f"{row[2]}")
            # logger.info(f"{row[2]}")
            
        csv_writer.writerow(row)

        if item['datatake_id'] != prev_datatake:
            prev_datatake = item['datatake_id']
            print(f"{item['datatake_id']}")


if __name__ == '__main__':
    query_datatakes()

exit(0)