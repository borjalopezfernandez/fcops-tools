#!/usr/bin/env python

'''

> https://explorer.maap.eo.esa.int/

'''

import os
import json
from pystac_client import Client


from loguru import logger
logger = logger.patch(lambda record: record.update(name=record["file"].name))

from importlib.metadata import version as package_version

import click
CONTEXT_SETTINGS = {"help_option_names": ['-h', '--help'], "max_content_width" : 220}

@click.command(context_settings=CONTEXT_SETTINGS, no_args_is_help = True)
@click.option('--id', '-i',                                              help = 'datatake id / e.g. 1801')
@click.option('--type', '-t',                                            help = 'productType filter L0__OBS___ | L1B_OBS___ | L1C_FLXSYN | L2__FLXSYN' )
@click.option('--version', '-v',     is_flag = True, default = False,    help = 'It shows the version')
@click.option('--Silent', '-S',      is_flag = True, default = False,    help = 'Avoid logging messages')
@click.option('--Debug', '-D',       is_flag = True, default = False,    help = 'Debug flag for verbose messages')


def query_datatake_id(id: str, type: str, version: bool, silent: bool, debug: bool):

    """
    \b
    Query MAAP catalogue for FLEX products corresponding to a specific datatake ID.

    metadata: eopf:datatake_id

    https://catalog.maap.eo.esa.int/catalogue/collections/FLEXRAWL0CALVALProducts10/queryables
    https://catalog.maap.eo.esa.int/catalogue/collections/FLEXL1CommissioningProducts10/queryables
    https://catalog.maap.eo.esa.int/catalogue/collections/FLEXL2Products10/queryables

    \b

    """    

    if version == True:
        print(f"{os.path.basename(__file__)} - {package_version('fcops')}")
        exit(0)

    URL_LANDING_PAGE    = 'https://catalog.maap.eo.esa.int/catalogue/'
    FLEX_COLLECTIONS    = ['FLEXL0EOProductsInternal', 'FLEXL1BEOProductsInternal', 'FLEXL1BCalProductsInternal', 'FLEXL1CEOProductsInternal', 'FLEXL2EOProductsInternal']
    
    if type in ['L0__OBS___']:
        FLEX_COLLECTIONS = ['FLEXL0EOProductsInternal']
    
    if type in ['L0__CLOUD_', 'L0__CTE___', 'L0__DARKNP', 'L0__DARKOC', 'L0__DARKSR', 'L0__DEFDAR', 'L0__DEFRTS', 'L0__DEFSUN', 'L0__DRKMTF', 'L0__DRKSTR', 'L0__LINDAR', 'L0__LINDES', 'L0__LINSEA', 'L0__LINSUN', 'L0__MOONSL', 'L0__MOON__', 'L0__SUN___']:
        FLEX_COLLECTIONS = ['FLEXL0CALProductsInternal']
    
    if type in ['L1B_OBS___']:
        FLEX_COLLECTIONS = ['FLEXL1BEOProductsInternal']
    
    if type in ['L1C_FLXSYN']:
        FLEX_COLLECTIONS = ['FLEXL1CEOProductsInternal']

    if type in ['L2__FLXSYN']:
        FLEX_COLLECTIONS = ['FLEXL2EOProductsInternal']
    
    api                 = None

    try:
        api = Client.open(URL_LANDING_PAGE)
    except Exception as e:
        logger.error(f"Error when connecting to {URL_LANDING_PAGE}")
        logger.error(f"{e}")
        exit(1)
    
    if debug == True:
        logger.debug(f'querying collections {FLEX_COLLECTIONS}')
        logger.debug(f'querying products with datatake-id {id}')
    
    results = api.search(
            method      = "GET",
            collections = FLEX_COLLECTIONS,
            filter      = f"eopf:datatake_id={id}"
        )

    items = []
    try:
        items = list(results.items())
    except Exception as e:
        logger.error(f"Error when querying {id}")
        logger.error(f"{e}")
        exit(1)

    if len(items) == 0:
        if debug == True:
            logger.debug(f'No items found between with id {id}')
        exit(1)
    
    for item in items:
        print(f"{item.id}, {item.properties['product:type']}, Start: {item.properties['start_datetime']}, End: {item.properties['end_datetime']}")


def version():
    return package_version('fcops')

if __name__ == '__main__':
    query_datatake_id()


exit(0)