                    'type': ['forecast'],
                    'area': [75, -180, -56, 180],
                    'data_format': 'netcdf_zip'
    }

    if list == False or list == True:
        logger.info(f"Requesting collection '{collection_id}' for {filename} with the following parameters:")
        logger.info(json.dumps(request_cams_global_atmospheric_composition_forecasts, indent=4))


    constrained_request = client.apply_constraints(collection_id, request_cams_global_atmospheric_composition_forecasts)

    logger.info(f"Collection {collection_id} coverage: {constrained_request['date'][-1]}")
  
    if list == False:
        try:
            remote = client.retrieve(collection_id, request_cams_global_atmospheric_composition_forecasts, target=filename)
            logger.info(f"Retrieved {filename}")
        # results = client.get_results(remote.request_id)
        except Exception as e:
            logger.error(f"Error during retrieval: {e}")
    
    exit(0)

