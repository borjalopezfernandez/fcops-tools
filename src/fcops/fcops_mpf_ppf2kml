"""
FLEX Planning File (PPF) Parser CLI

Command-line interface for parsing and querying FLEX mission planning XML files.
"""
import os
import click
import json
import importlib
from pathlib import Path
from datetime import datetime, timezone
from typing import Optional

from importlib.metadata import version as package_version

from fcops.parser_xml_ppf import parse_file, PlanningFile

try:
    import eocfi
except Exception as e:
    print(f'Error importing eocfi: {e}')
    print(f'Please install eocfi:') 
    print('https://eop-cfi.esa.int/index.php/mission-cfi-software/eocfi-software')
