@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
def analyze(filepath):
    """Perform detailed analysis of a planning file."""
    try:
        planning = parse_file_ppf(filepath)
        
        click.echo("\n" + "=" * 70)
        click.echo("DETAILED ANALYSIS")
        click.echo("=" * 70)
        
        # Time analysis
        times = [e.time for e in planning.events if e.time]
        if times:
            click.echo(f"\nTime Range:")
            click.echo(f"  First Event:  {min(times)}")
            click.echo(f"  Last Event:   {max(times)}")
            duration = max(times) - min(times)
            click.echo(f"  Duration:     {duration}")
        
        # Orbit analysis
        orbits = [e.absolute_orbit for e in planning.events]
        if orbits:
            click.echo(f"\nOrbit Coverage:")
            click.echo(f"  Total distinct orbits: {len(set(orbits))}")
            click.echo(f"  Min orbit: {min(orbits)}")
            click.echo(f"  Max orbit: {max(orbits)}")
            click.echo(f"  Events per orbit (avg): {len(planning.events) / len(set(orbits)):.1f}")
        
        # Event grouping analysis
        groups = {}
        for event in planning.events:
            group = event.group_id
            if group not in groups:
                groups[group] = {'count': 0, 'ids': set()}
            groups[group]['count'] += 1
            groups[group]['ids'].add(event.event_id)
        
        click.echo(f"\nGroup Analysis:")
        click.echo(f"  Total groups: {len(groups)}")
        click.echo(f"  Events per group (avg): {len(planning.events) / len(groups):.1f}")
        
        # Find groups with most events
        top_groups = sorted(groups.items(), key=lambda x: -x[1]['count'])[:5]
        click.echo(f"\n  Top 5 groups by event count:")
        for group_id, info in top_groups:
            click.echo(f"    Group {group_id}: {info['count']} events, IDs: {', '.join(sorted(info['ids']))}")
        
        # Parameter analysis
        params_found = {}
        for event in planning.events:
            for key in event.parameters.keys():
                params_found[key] = params_found.get(key, 0) + 1
        
        if params_found:
            click.echo(f"\nParameters Found:")
            for param, count in sorted(params_found.items(), key=lambda x: -x[1]):
                click.echo(f"  {param}: {count} occurrences")
        
        click.echo("=" * 70 + "\n")
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


