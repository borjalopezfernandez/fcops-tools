from eocfi.api    import version as eocfi_version
from eocfi.api_xo import xo_check_library_version

def print_version(ctx, param, value):
    if not value or ctx.resilient_parsing:
        return
    print(f"{os.path.basename(__file__)} - {package_version('fcops')}")
    print()
    print(f'eocfi - {eocfi_version()}')
    xo_check_library_version()
    ctx.exit()

@click.group()
@click.option('--version', is_flag=True, callback=print_version, expose_value=False, is_eager=True, help='Show version and library information.')
def cli():
    """FLEX Planning File (PPF) Parser - Parse and query FLEX mission planning files."""
    pass


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
def info(filepath):
    """Display header information from a planning file."""
    try:
        planning = parse_file(filepath)
        
        click.echo("\n" + "=" * 70)
        click.echo("PLANNING FILE INFORMATION")
        click.echo("=" * 70)
        click.echo(f"\nSpacecraft:        {planning.header.spacecraft}")
        click.echo(f"Purpose:           {planning.header.purpose}")
        click.echo(f"Filename:          {planning.header.filename}")
        click.echo(f"ICD Version:       {planning.header.icd_version}")
        click.echo(f"Format Version:    {planning.header.format_version}")
        click.echo(f"Generated:         {planning.header.gen_time}")
        click.echo(f"Validity Start:    {planning.header.validity_start}")
        click.echo(f"Validity End:      {planning.header.validity_end}")
        click.echo(f"\nTotal Events:      {len(planning.events)}")
        click.echo("=" * 70 + "\n")
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
@click.option('--limit', '-l', type=int, default=10, help='Number of events to display')
def list(filepath, limit):
    """List events from a planning file."""
    try:
        planning = parse_file(filepath)
        
        click.echo(f"\nShowing first {min(limit, len(planning.events))} events:\n")
        
        for i, event in enumerate(planning.events[:limit], 1):
            click.echo(f"{i}. [{event.event_id}] {event.description}")
            click.echo(f"   Time: {event.time}")
            click.echo(f"   Type: {event.event_type}")
            click.echo(f"   Orbit: {event.absolute_orbit} (relative: {event.relative_orbit})")
            if event.parameters:
                click.echo(f"   Parameters: {event.parameters}")
            click.echo()
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
def stats(filepath):
    """Display statistics about events in a planning file."""
    try:
        planning = parse_file(filepath)
        
        # Count by event ID
        id_counts = {}
        for event in planning.events:
            id_counts[event.event_id] = id_counts.get(event.event_id, 0) + 1
        
        # Count by type
        type_counts = {}
        for event in planning.events:
            type_counts[event.event_type] = type_counts.get(event.event_type, 0) + 1
        
        # Count by orbit
        orbit_counts = {}
        for event in planning.events:
            orbit = event.absolute_orbit
            orbit_counts[orbit] = orbit_counts.get(orbit, 0) + 1
        
        click.echo("\n" + "=" * 70)
        click.echo("STATISTICS")
        click.echo("=" * 70)
        
        click.echo(f"\nTotal Events: {len(planning.events)}\n")
        
        click.echo("Events by Type:")
        for event_type, count in sorted(type_counts.items(), key=lambda x: -x[1]):
            click.echo(f"  {event_type}: {count}")
        
        click.echo("\nTop 10 Event IDs:")
        for event_id, count in sorted(id_counts.items(), key=lambda x: -x[1])[:10]:
            click.echo(f"  {event_id}: {count}")
        
        click.echo(f"\nUnique Orbits: {len(orbit_counts)}")
        click.echo(f"Orbit Range: {min(orbit_counts.keys())} - {max(orbit_counts.keys())}")
        
        click.echo("=" * 70 + "\n")
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
@click.option('--id', 'event_id', help='Filter by event ID')
@click.option('--type', 'event_type', help='Filter by event type')
@click.option('--orbit', type=int, help='Filter by absolute orbit number')
@click.option('--start', help='Start time (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)')
@click.option('--end', help='End time (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)')
@click.option('--limit', '-l', type=int, default=20, help='Maximum number of results')
@click.option('--json', 'output_json', is_flag=True, help='Output as JSON')
def search(filepath, event_id, event_type, orbit, start, end, limit, output_json):
    """Search and filter events in a planning file."""
    try:
        planning = parse_file(filepath)
        results = planning.events
        
        # Apply filters
        if event_id:
            results = planning.get_events_by_id(event_id)
            click.echo(f"Searching for event ID: {event_id}\n", err=True)
        
        if event_type:
            results = [e for e in results if e.event_type == event_type]
            click.echo(f"Filtering by type: {event_type}\n", err=True)
        
        if orbit:
            results = [e for e in results if e.absolute_orbit == orbit]
            click.echo(f"Filtering by orbit: {orbit}\n", err=True)
        
        if start and end:
            try:
                # Parse dates
                if 'T' not in start:
                    start = start + 'T00:00:00'
                if 'T' not in end:
                    end = end + 'T23:59:59'
                
                start_dt = datetime.fromisoformat(start.replace('Z', '+00:00')).replace(tzinfo=timezone.utc)
                end_dt = datetime.fromisoformat(end.replace('Z', '+00:00')).replace(tzinfo=timezone.utc)
                
                results = [e for e in results if start_dt <= e.time <= end_dt]
                click.echo(f"Filtering by time: {start} to {end}\n", err=True)
            except ValueError as e:
                click.echo(click.style(f"Error parsing dates: {e}", fg='red'), err=True)
                raise SystemExit(1)
        
        # Limit results
        results = results[:limit]
        
        if output_json:
            output = {
                'count': len(results),
                'events': [e.to_dict() for e in results]
            }
            click.echo(json.dumps(output, indent=2, default=str))
        else:
            click.echo(f"Found {len(results)} events:\n")
            for i, event in enumerate(results, 1):
                click.echo(f"{i}. [{event.event_id}] {event.description}")
                click.echo(f"   Time: {event.time}")
                click.echo(f"   Group ID: {event.group_id}")
                if event.parameters:
                    click.echo(f"   Parameters: {event.parameters}")
                click.echo()
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
@click.option('--output', '-o', type=click.Path(), help='Output file path (default: stdout)')
@click.option('--pretty', is_flag=True, help='Pretty print JSON')
def export(filepath, output, pretty):
    """Export planning file data as JSON."""
    try:
        planning = parse_file(filepath)
        data = planning.to_dict()
        
        if pretty:
            json_str = json.dumps(data, indent=2, default=str)
        else:
            json_str = json.dumps(data, default=str)
        
        if output:
            with open(output, 'w') as f:
                f.write(json_str)
            click.echo(f"Data exported to: {output}")
        else:
            click.echo(json_str)
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
def analyze(filepath):
    """Perform detailed analysis of a planning file."""
    try:
        planning = parse_file(filepath)
        
        click.echo("\n" + "=" * 70)
        click.echo("DETAILED ANALYSIS")
        click.echo("=" * 70)
        
        # Time analysis
        times = [e.time for e in planning.events if e.time]
        if times:
            click.echo(f"\nTime Range:")
            click.echo(f"  First Event:  {min(times)}")
            click.echo(f"  Last Event:   {max(times)}")
            duration = max(times) - min(times)
            click.echo(f"  Duration:     {duration}")
        
        # Orbit analysis
        orbits = [e.absolute_orbit for e in planning.events]
        if orbits:
            click.echo(f"\nOrbit Coverage:")
            click.echo(f"  Total distinct orbits: {len(set(orbits))}")
            click.echo(f"  Min orbit: {min(orbits)}")
            click.echo(f"  Max orbit: {max(orbits)}")
            click.echo(f"  Events per orbit (avg): {len(planning.events) / len(set(orbits)):.1f}")
        
        # Event grouping analysis
        groups = {}
        for event in planning.events:
            group = event.group_id
            if group not in groups:
                groups[group] = {'count': 0, 'ids': set()}
            groups[group]['count'] += 1
            groups[group]['ids'].add(event.event_id)
        
        click.echo(f"\nGroup Analysis:")
        click.echo(f"  Total groups: {len(groups)}")
        click.echo(f"  Events per group (avg): {len(planning.events) / len(groups):.1f}")
        
        # Find groups with most events
        top_groups = sorted(groups.items(), key=lambda x: -x[1]['count'])[:5]
        click.echo(f"\n  Top 5 groups by event count:")
        for group_id, info in top_groups:
            click.echo(f"    Group {group_id}: {info['count']} events, IDs: {', '.join(sorted(info['ids']))}")
        
        # Parameter analysis
        params_found = {}
        for event in planning.events:
            for key in event.parameters.keys():
                params_found[key] = params_found.get(key, 0) + 1
        
        if params_found:
            click.echo(f"\nParameters Found:")
            for param, count in sorted(params_found.items(), key=lambda x: -x[1]):
                click.echo(f"  {param}: {count} occurrences")
        
        click.echo("=" * 70 + "\n")
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
def config():
    """Display the configuration file contents."""
    try:
        import importlib.resources
        import fcops
        
        # Get the path to the config file in package data
        config_path = None
        try:
            # For Python 3.9+
            config_path = importlib.resources.files(fcops) / "data" / "FLX_OPER_MPL_ORBSCT_20240204T220001_99999999T999999_0001.EOF"
        except AttributeError:
            # For older Python versions, use pkg_resources
            import pkg_resources
            config_path = Path(pkg_resources.resource_filename('fcops', 'data/FLX_OPER_MPL_ORBSCT_20240204T220001_99999999T999999_0001.EOF'))
        
        if not config_path.exists():
            click.echo(click.style(f"Config file not found: {config_path}", fg='red'), err=True)
            raise SystemExit(1)
        
        click.echo(config_path)
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)



if __name__ == '__main__':
    cli()
