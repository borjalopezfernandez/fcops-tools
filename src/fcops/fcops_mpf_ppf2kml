@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
def stats(filepath):
    """Display statistics about events in a planning file."""
    try:
        planning = parse_file_ppf(filepath)
        
        # Count by event ID
        id_counts = {}
        for event in planning.events:
            id_counts[event.event_id] = id_counts.get(event.event_id, 0) + 1
        
        # Count by type
        type_counts = {}
        for event in planning.events:
            type_counts[event.event_type] = type_counts.get(event.event_type, 0) + 1
        
        # Count by orbit
        orbit_counts = {}
        for event in planning.events:
            orbit = event.absolute_orbit
            orbit_counts[orbit] = orbit_counts.get(orbit, 0) + 1
        
        click.echo("\n" + "=" * 70)
        click.echo("STATISTICS")
        click.echo("=" * 70)
        
        click.echo(f"\nTotal Events: {len(planning.events)}\n")
        
        click.echo("Events by Type:")
        for event_type, count in sorted(type_counts.items(), key=lambda x: -x[1]):
            click.echo(f"  {event_type}: {count}")
        
        click.echo("\nTop 10 Event IDs:")
        for event_id, count in sorted(id_counts.items(), key=lambda x: -x[1])[:10]:
            click.echo(f"  {event_id}: {count}")
        
        click.echo(f"\nUnique Orbits: {len(orbit_counts)}")
        click.echo(f"Orbit Range: {min(orbit_counts.keys())} - {max(orbit_counts.keys())}")
        
        click.echo("=" * 70 + "\n")
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)


@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
@click.option('--id', 'event_id', help='Filter by event ID')
@click.option('--type', 'event_type', help='Filter by event type')
@click.option('--orbit', type=int, help='Filter by absolute orbit number')
@click.option('--start', help='Start time (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)')
@click.option('--end', help='End time (ISO format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS)')
@click.option('--limit', '-l', type=int, default=20, help='Maximum number of results')
@click.option('--json', 'output_json', is_flag=True, help='Output as JSON')
def search(filepath, event_id, event_type, orbit, start, end, limit, output_json):
    """Search and filter events in a planning file."""
    try:
        planning = parse_file_ppf(filepath)
        results = planning.events
        
        # Apply filters
        if event_id:
            results = planning.get_events_by_id(event_id)
            click.echo(f"Searching for event ID: {event_id}\n", err=True)
        
        if event_type:
            results = [e for e in results if e.event_type == event_type]
            click.echo(f"Filtering by type: {event_type}\n", err=True)
        
        if orbit:
            results = [e for e in results if e.absolute_orbit == orbit]
            click.echo(f"Filtering by orbit: {orbit}\n", err=True)
        
        if start and end:
            try:
                # Parse dates
                if 'T' not in start:
                    start = start + 'T00:00:00'
                if 'T' not in end:
                    end = end + 'T23:59:59'
                
                start_dt = datetime.fromisoformat(start.replace('Z', '+00:00')).replace(tzinfo=timezone.utc)
                end_dt = datetime.fromisoformat(end.replace('Z', '+00:00')).replace(tzinfo=timezone.utc)
                
                results = [e for e in results if start_dt <= e.time <= end_dt]
                click.echo(f"Filtering by time: {start} to {end}\n", err=True)
            except ValueError as e:
                click.echo(click.style(f"Error parsing dates: {e}", fg='red'), err=True)
                raise SystemExit(1)
        
        # Limit results
        results = results[:limit]
        
        if output_json:
            output = {
                'count': len(results),
                'events': [e.to_dict() for e in results]
            }
            click.echo(json.dumps(output, indent=2, default=str))
        else:
            click.echo(f"Found {len(results)} events:\n")
            for i, event in enumerate(results, 1):
                click.echo(f"{i}. [{event.event_id}] {event.description}")
                click.echo(f"   Time: {event.time}")
                click.echo(f"   Group ID: {event.group_id}")
                if event.parameters:
                    click.echo(f"   Parameters: {event.parameters}")
                click.echo()
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)

