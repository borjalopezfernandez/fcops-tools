'''

fcops_mpf_ppf2kml list --orbit test/data/FLX_OPER_MPL_ORBSCT_20230703T000001_99999999T999999_0001.EOF --kml test/data/FLX_OPER_MPL_NPPF___20230703T000000_20230730T000000_0002.xml > test/data/FLX_OPER_MPL_NPPF___20230703T000000_20230730T000000_0002.kml

'''

@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
@click.option('--limit', '-l', type=int, default = 10   ,   help = 'Number of events to display')
@click.option('--kml',      is_flag=True                ,   help = 'Output datatakes as KML')
@click.option('--orbit', '-o', type=str                 ,   help = 'Orbit Scenario File')
@click.option('--utm', '-u',    is_flag = True, default = False, help = 'Output datatakes UTM coordinates')
@click.option('--Debug', '-D',  is_flag = True, default = False, help = 'Debug flag for verbose messages')
@click.pass_context
def list(ctx, filepath, limit, kml, utm, orbit, debug):
    """List events from a planning file."""

    from eocfi.api_xl import xl_model_init
    from eocfi.api_xl import xl_time_ref_init_file
    from eocfi.api_xo import xo_orbit_init_file
    from eocfi.api_xp import xp_atmos_init
    from eocfi.api_xv import xv_swath_id_init
    from eocfi.api_xv import xv_swathpos_compute
    from eocfi.c_types import XV_Time
    from eocfi.constants import XL_MODEL_DEFAULT, XP_STD_INIT, XV_UTC_TYPE, XV_FILE_SDF

    if orbit == None or orbit == '':
        path_orb_sct = importlib.resources.files(fcops) / 'data' / FLX_OSC
    else:
        path_orb_sct = orbit
        
    path_sdf        = importlib.resources.files(fcops) / 'data' / FLX_SDF
    # debug           = ctx.obj.get('debug', False) if ctx.obj else False
    
    ppf_name = Path(os.path.basename(filepath)).stem

    if debug == True:
        logger.info(f'initialise eocfi functions')

    if debug == True:
        logger.info(f'xl_time_ref_init_file XL_MODEL_DEFAULT')
    xl_model_init(XL_MODEL_DEFAULT, debug)

    if debug == True:
        logger.info(f'xl_time_ref_init_file {os.path.basename(str(path_orb_sct))}')
    xl_time_ref_init_file(str(path_orb_sct), debug)

    if debug == True:
        logger.info(f'xl_time_ref_init_file {os.path.basename(str(path_orb_sct))}')
    xo_orbit_init_file(str(path_orb_sct), debug)

    if debug == True:
        logger.info(f'xv_swath_id_init {os.path.basename(str(path_sdf))}')
    swath_mode = XV_FILE_SDF
    xv_swath_id_init(swath_mode, str(path_sdf), debug)

    if debug == True:
        logger.info(f'Parsing PPF {filepath}')

    try:
        planning = parse_file_ppf(filepath)

        if not kml:
            click.echo(f"\nShowing first {min(limit, len(planning.events))} events:\n")
            
            for i, event in enumerate(planning.events[:limit], 1):
                click.echo(f"{i}. [{event.event_id}] {event.description}")
                click.echo(f"   Time: {event.time}")
                click.echo(f"   Type: {event.event_type}")
                click.echo(f"   Orbit: {event.absolute_orbit} (relative: {event.relative_orbit})")
                if event.parameters:
                    click.echo(f"   Parameters: {event.parameters}")
                click.echo()

        # Detect datatakes: groups where FPOBS_ID, FTOEARTH, and FTOCNFG_ events coexist
        # Also detect calibration datatakes: groups where FPCAL_ID, FTOCALIB, and FTOCNFG_ events coexist
        group_events = {}
        for event in planning.events:
            '''
            if event.event_id == 'FPCAL_ID':
                logger.debug(event)
            '''
            group_events.setdefault(event.group_id, []).append(event)

        # -----------------------------------------------------------
        # Obtain the datatakes from the grouped events
        # Group events with calibrations can lead to various datatakes

        last_calib_id       = None
        last_calib_id_eob   = None
        last_calib_id_cal   = None

        datatakes = []
        for group_id, events in group_events.items():
            event_ids       = {e.event_id for e in events}
            
            # Check for observation datatakes
            has_fpobs       = 'FPOBS_ID' in event_ids
            has_ftoearth    = 'FTOEARTH' in event_ids
            
            # Check for calibration datatakes
            has_fpcal       = 'FPCAL_ID' in event_ids
            has_ftocalib    = 'FTOCALIB' in event_ids

            # Other requests
            has_facqtime    = 'FACQTIME' in event_ids
            has_facqlinr    = 'FACQLINR' in event_ids

            # CU - Attitude
            has_cu_pos_dark = 'FCUDARK_' in event_ids
            has_cu_pos_sun  = 'FCUSUN__' in event_ids
            has_cu_nadir    = 'FCUNADIR' in event_ids
            has_cu_reset    = 'FCURESET' in event_ids

            # Transition to configuration
            has_ftocnfg     = 'FTOCNFG_' in event_ids
            
            if has_fpobs and has_ftoearth and has_ftocnfg:
                # Calculate duration as difference between FTOEARTH and FTOCNFG_
                fpobs_time      = None
                ftoearth_time   = None
                ftocnfg_time    = None
                # Identifier of calibration datatake
                calib_id_eob    = None
                
                if has_cu_pos_sun == True:
                    logger.warning(f'Unexpected Attitude SUN for FTOEARTH datatake')

                if has_cu_pos_dark == True:
                    logger.warning(f'Unexpected Attitude DARK for FTOEARTH datatake')

                if has_cu_reset == True:
                    logger.warning(f'Unexpected Attitude RESET for FTOEARTH datatake')

                for ev in events:
                    if ev.event_id == 'FPOBS_ID':
                        fpobs_time = ev.time
                        if debug == True:
                            logger.debug(f'CALIB_ID_EOB   = {ev.parameters.get('CALIB_ID_EOB', 0)}')
                        current_calib_id = int( ev.parameters.get('CALIB_ID_EOB', 0) )
                        if last_calib_id == None:
                            last_calib_id = current_calib_id
                        else:
                            if (last_calib_id + 1) != current_calib_id:
                                logger.warning(f'CALIB_ID_EOB {current_calib_id} breaks sequence wrt {last_calib_id}')
                            last_calib_id = current_calib_id
                    elif ev.event_id == 'FTOEARTH':
                        ftoearth_time = ev.time
                    elif ev.event_id.startswith('FTOCNFG_'):
                        ftocnfg_time = ev.time
                
                duration = None
                if ftoearth_time and ftocnfg_time:
                    duration = ftocnfg_time - ftoearth_time
                
                datatakes.append((group_id, events, duration, 'observation', fpobs_time, ftocnfg_time))
            
            elif has_fpcal and has_ftocalib and has_ftocnfg:
                '''
                if has_facqlinr == True:
                    logger.info(f'Group {group_id} has Linearity Calibration')

                if has_cu_pos_dark == True:
                    logger.info(f'Group {group_id} has Attitude DARK')

                if has_cu_pos_sun == True:
                    logger.info(f'Group {group_id} has Attitude SUN')
                '''

                fpcal_id_event  = None
                # Calculate duration as difference between FTOCALIB and FTOCNFG_
                fpcal_time      = None
                ftocalib_time   = None
                ftocnfg_time    = None
                # Identifier of calibration datatake
                calib_id_cal    = None

                # group calibrations have various FPCAL_ID events to enable & disable cal flags
                # > "FPCAL_ID" group_id="xxxx" parameter_count="7" CALIB_ID_CAL="425" HR1_CAL_TYPE="1" HR1_CAL_ST_CAL="11" HR2_CAL_TYPE="1" HR2_CAL_ST_CAL="11" LR_CAL_TYPE="1" LR_CAL_ST_CAL="11"/>
                # > "FPCAL_ID" group_id="xxxx" parameter_count="7" CALIB_ID_CAL="426" HR1_CAL_TYPE="1" HR1_CAL_ST_CAL="51" HR2_CAL_TYPE="1" HR2_CAL_ST_CAL="51" LR_CAL_TYPE="1" LR_CAL_ST_CAL="51"/>
                # > "FPCAL_ID" group_id="xxxx" parameter_count="7" CALIB_ID_CAL="427" HR1_CAL_TYPE="0" HR1_CAL_ST_CAL="0" HR2_CAL_TYPE="0" HR2_CAL_ST_CAL="0" LR_CAL_TYPE="0" LR_CAL_ST_CAL="0"/>
                # logger.debug(f"-----------------------------------------------------------------------------")
                # logger.debug(f"Calibration sequence: {group_id}")
                list_cal_events = []
                for ev in events:
                    # logger.debug(f"Calibration event: {ev.event_id} at {ev.time}")
                    list_cal_events.append(ev)
                    if ev.event_id == 'FPCAL_ID':
                        if debug == True:
                            logger.debug(f'CALIB_ID_CAL   = {ev.parameters.get('CALIB_ID_CAL', 0)}')
                            logger.debug(f'HR1_CAL_TYPE   = {ev.parameters.get('HR1_CAL_TYPE', 0)}')
                            logger.debug(f'HR1_CAL_ST_CAL = {ev.parameters.get('HR1_CAL_ST_CAL', 0)}')
                            logger.debug(f'HR2_CAL_ST_CAL = {ev.parameters.get('HR2_CAL_ST_CAL', 0)}')
                        current_calib_id = int( ev.parameters.get('CALIB_ID_CAL', 0) )
                        if last_calib_id == None:
                            last_calib_id = current_calib_id
                        else:
                            if (last_calib_id + 1) != current_calib_id:
                                logger.warning(f'CALIB_ID_CAL {current_calib_id} breaks sequence wrt {last_calib_id}')
                            last_calib_id = current_calib_id
                        fpcal_time      = ev.time
                        fpcal_id_event  = ev
                    elif ev.event_id == 'FTOCALIB':
                        ftocalib_time   = ev.time
                    elif ev.event_id.startswith('FTOCNFG_'):
                        ftocnfg_time = ev.time
                        duration = None
                        if ftocalib_time and ftocnfg_time:
                            duration = ftocnfg_time - ftocalib_time
                            datatakes.append((group_id, list_cal_events, duration, 'calibration', ftocalib_time, ftocnfg_time))
                            list_cal_events = []
                            ftocalib_time   = None
                            ftocnfg_time    = None
                            fpcal_time      = None
                            fpcal_id_event  = None

                if fpcal_id_event != None: # and fpcal_id_event != None and fpcal_id_event.parameters.get("HR1_CAL_TYPE", 0) == 1:
                    if fpcal_id_event.parameters.get("HR1_CAL_TYPE", 0) == 1:
                        logger.warning(f"Orphan FPCAL_ID {current_calib_id} at {fpcal_time} / Group ID: {group_id} | missing FTOCALIB or FTOCNFG_ events to determine datatake")

        # -----------------------------------------------------------

        if datatakes:

            if utm:
                # Load UTM tiles from AUX_UTMTIL file
                path_aux_utmtil = importlib.resources.files(fcops) / 'data' / FLX_AUX_UTMTIL
                utm_bboxes      = _get_bboxes_by_tile_id(str(path_aux_utmtil), debug)

                list_utm_polygons       = []
                list_utm_polygons_proj  = []
                for tile_id, corners in utm_bboxes.items():
                    # logger.info(f"xxx Tile ID: {tile_id}, BBOX: {corners} - {type(corners)}")
                    polygon_utm = _utm_bbox_to_polygon_proj(tile_id, corners, debug)
                    list_utm_polygons.append(polygon_utm)

            sorted_datatakes  = sorted(datatakes, key=lambda x: x[4] if x[4] else float('inf'))
            
            if kml:
                # Generate KML
                root        = etree.Element('kml', xmlns='http://www.opengis.net/kml/2.2')
                document    = etree.SubElement(root, 'Document')
                etree.SubElement(document, 'name').text = f'{ppf_name}'
                
                 # Add UTM tiles
                style_obs = etree.SubElement(document, 'Style')
                style_obs.set('id', 'UTMStyle')
                line_style_obs = etree.SubElement(style_obs, 'LineStyle')
                etree.SubElement(line_style_obs, 'color').text = 'ffffff00'  # green
                etree.SubElement(line_style_obs, 'width').text = '2'

                # Add styles for observation and calibration
                style_obs = etree.SubElement(document, 'Style')
                style_obs.set('id', 'observationStyle')
                # poly_style_obs = etree.SubElement(style_obs, 'PolyStyle')
                # etree.SubElement(poly_style_obs, 'color').text = '0000ff00'  # transparent green
                # etree.SubElement(poly_style_obs, 'fill').text = '1'
                line_style_obs = etree.SubElement(style_obs, 'LineStyle')
                etree.SubElement(line_style_obs, 'color').text = 'ff00ff00'  # green
                etree.SubElement(line_style_obs, 'width').text = '2'
                
                style_cal = etree.SubElement(document, 'Style')
                style_cal.set('id', 'calibrationStyle')
                # poly_style_cal = etree.SubElement(style_cal, 'PolyStyle')
                # etree.SubElement(poly_style_cal, 'color').text = '000000ff'  # transparent blue
                # etree.SubElement(poly_style_cal, 'fill').text = '1'
                line_style_cal = etree.SubElement(style_cal, 'LineStyle')
                etree.SubElement(line_style_cal, 'color').text = 'ff0000ff'  # blue
                etree.SubElement(line_style_cal, 'width').text = '2'

                style_cal = etree.SubElement(document, 'Style')
                style_cal.set('id', 'utmStyle')
                # poly_style_cal = etree.SubElement(style_cal, 'PolyStyle')
                # etree.SubElement(poly_style_cal, 'color').text = '000000ff'  # transparent blue
                # etree.SubElement(poly_style_cal, 'fill').text = '1'
                line_style_cal = etree.SubElement(style_cal, 'LineStyle')
                etree.SubElement(line_style_cal, 'color').text = 'ffffff00'  # blue
                etree.SubElement(line_style_cal, 'width').text = '2'

                obs_folder  = etree.SubElement(document, 'Folder')
                etree.SubElement(obs_folder, 'name').text = 'Datatakes Observation'
                
                cal_folder = etree.SubElement(document, 'Folder')
                etree.SubElement(cal_folder, 'name').text = 'Datatakes Calibration'

                '''
                    utm_folder = etree.SubElement(document, 'Folder')
                    etree.SubElement(utm_folder, 'name').text = 'Calibration UTM Tiles'
                '''

                for idx, (group_id, events, duration, dt_type, start_time, end_time) in enumerate(sorted_datatakes):
                    # Compute positions every 10 seconds between start and end
                    positions_west  = []
                    positions_east  = []
                    current_time    = start_time
                    separation      = None
                    while current_time <= end_time:
                        time_swath          = XV_Time()
                        time_swath.type     = XV_UTC_TYPE
                        time_swath.utc_time = eocfi.converters.datetime_utc_to_mjd2000(current_time)
                        pos                 = xv_swathpos_compute(time_swath, False)
                        '''
                        if debug == True:
                            logger.debug(f"Computed position for {current_time}: {pos}")
                        '''

                        # Avoid the swath middle point pos[1][1]
                        positions_west.append(pos[1][0])
                        positions_east.append(pos[1][2])
                        current_time += timedelta(seconds = 10)
                    
                    # Extract calibration ID parameter and event(s) attributes
                    if dt_type == 'observation':
                        param_name          = 'CALIB_ID_EOB'
                        event_id_to_find    = 'FPOBS_ID'
                    else:  # calibration
                        param_name          = 'CALIB_ID_CAL'
                        event_id_to_find    = 'FPCAL_ID'
                    
                    param_value = None
                    event_obj   = None

                    # Find the CALIB_ID_xxx event: CALIB_ID_EOB | CALIB_ID_CAL
                    for ev in events:
                        if ev.event_id == event_id_to_find:
                            param_value = ev.parameters.get(param_name)
                            event_obj   = ev
                            break

                    # Create single Placemark for datatake with LinearRing connecting start and end
                    parent_folder   = obs_folder if dt_type == 'observation' else cal_folder
                    subfolder       = etree.SubElement(parent_folder, 'Folder')

                    if dt_type == 'observation':
                        etree.SubElement(subfolder, 'name').text = f'DT#{param_value} - {start_time.strftime("%Y-%m-%d %H:%M:%S")}'
                    else:
                        etree.SubElement(subfolder, 'name').text = f'DT#{param_value} - {start_time.strftime("%Y-%m-%d %H:%M:%S")} - {get_floris_mode_label(int(event_obj.parameters.get("HR1_CAL_ST_CAL", 0)))}'

                    description = f'Type: {dt_type}\nDuration: {duration}\nStart: {start_time}\nEnd: {end_time}'
                    if idx < len(sorted_datatakes) - 1:
                        next_start_time = sorted_datatakes[idx + 1][4]
                        if end_time and next_start_time:
                            separation = next_start_time - end_time
                            description += f'\nSeparation to next: {separation}'
                    etree.SubElement(subfolder, 'description').text = description
                    
                    placemark = etree.SubElement(subfolder, 'Placemark')


