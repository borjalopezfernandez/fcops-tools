@cli.command()
@click.argument('filepath', type=click.Path(exists=True))
def info(filepath):
    """Display header information from a planning file."""
    try:
        planning = parse_file_ppf(filepath)
        
        click.echo("\n" + "=" * 70)
        click.echo("PLANNING FILE INFORMATION")
        click.echo("=" * 70)
        click.echo(f"\nSpacecraft:        {planning.header.spacecraft}")
        click.echo(f"Purpose:           {planning.header.purpose}")
        click.echo(f"Filename:          {planning.header.filename}")
        click.echo(f"ICD Version:       {planning.header.icd_version}")
        click.echo(f"Format Version:    {planning.header.format_version}")
        click.echo(f"Generated:         {planning.header.gen_time}")
        click.echo(f"Validity Start:    {planning.header.validity_start}")
        click.echo(f"Validity End:      {planning.header.validity_end}")
        click.echo(f"\nTotal Events:      {len(planning.events)}")
        click.echo("=" * 70 + "\n")
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)

