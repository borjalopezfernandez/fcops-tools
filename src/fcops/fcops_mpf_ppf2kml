@cli.command()
def config():
    """Display the configuration file contents."""
    try:
        import importlib.resources
        import fcops
        
        # Get the path to the config file in package data
        config_path_osc = None
        config_path_sdf = None
        try:
            # For Python 3.9+
            config_path_osc = importlib.resources.files(fcops) / "data" / FLX_OSC
            config_path_sdf = importlib.resources.files(fcops) / "data" / FLX_SDF
        except AttributeError:
            # For older Python versions, use pkg_resources
            import pkg_resources
            config_path_osc = Path(pkg_resources.resource_filename('fcops', f'data/{FLX_OSC}'))
            config_path_sdf = Path(pkg_resources.resource_filename('fcops', f'data/{FLX_SDF}'))
        
        if not config_path_osc.exists():
            click.echo(click.style(f"Config file not found: {config_path_osc}", fg='red'), err=True)
            raise SystemExit(1)
        
        if not config_path_sdf.exists():
            click.echo(click.style(f"Config file not found: {config_path_sdf}", fg='red'), err=True)
            raise SystemExit(1)

        click.echo(config_path_osc)
        click.echo(config_path_sdf)
        
    except Exception as e:
        click.echo(click.style(f"Error: {e}", fg='red'), err=True)
        raise SystemExit(1)

