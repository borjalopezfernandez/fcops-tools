def print_version(ctx, param, value):
    if not value or ctx.resilient_parsing:
        return
    print(f"{os.path.basename(__file__)} - {package_version('fcops')}")
    print()
    print(f'eocfi - {eocfi_version()}')
    xo_check_library_version()
    ctx.exit()

# Configure debug logging
def setup_debug_logging(debug_enabled):
    """Setup debug logging if enabled."""
    if debug_enabled:
        logger.enable("fcops")
        logger.add(
            lambda msg: None,  # Dummy sink for now
            level="DEBUG",
            format="<level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>"
        )
        logger.debug("Debug logging enabled")

@click.group()
@click.option('--version', is_flag=True, callback=print_version, expose_value=False, is_eager=True, help='Show version and library information.')
@click.option('--debug', is_flag=True, help='Enable debug logging.')
@click.pass_context
def cli(ctx, debug):
    """
    \b
        FCOPS - Parse and query FLEX mission planning files.
    \b
    """
    # Ensure that ctx.obj exists
    if ctx.obj is None:
        ctx.obj = {}
    ctx.obj['debug'] = debug
    setup_debug_logging(debug)

